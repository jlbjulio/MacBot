{
  "name": "macbot",
  "version": "0.3.0",
  "private": true,
  "description": "MacBot \u00b7 local AI workspace",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:browser": "node scripts/dev.mjs --web-only",
    "dev:backend": "node scripts/dev.mjs --backend-only",
    "build": "tsc --noEmit && vite build",
    "start": "node scripts/start.mjs",
    "tauri": "tauri",
    "build:backend": "node scripts/build-desktop.mjs --prepare-only",
    "build:desktop": "node scripts/build-desktop.mjs",
    "check": "tsc --noEmit",
    "test:backend": "node scripts/dev.mjs --test-backend"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
