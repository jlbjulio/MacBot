{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "MacBot main window; external links limited to HTTP(S)",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }]
    }
  ]
}
